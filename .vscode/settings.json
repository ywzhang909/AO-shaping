{
    "terminal.integrated.env.windows": {
        "env": "${workspaceFolder}/.env",
        "python.terminal.useEnvFile": "${workspaceFolder}/.env",
        "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/libs;${env:PYTHONPATH}",
        "PATH": "${workspaceFolder}/libs/Drv_UDPST/x64/Release;${env:PATH}",
    },
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/libs;${env:PYTHONPATH}",
        "PATH": "${workspaceFolder}/libs/Drv_UDPST/x64/Release;${env:PATH}",
    },
    "python.testing.pytestArgs": [
        "-s"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.terminal.useEnvFile": true,
    "python.envFile": "${workspaceFolder}/.env",
    "python.testing.pytestPath": "${workspaceFolder}/.venv/Scrits/pytest.exe",
    "[dotenv]": {
        "editor.formatOnSave": true
    },
    "python-env.workspaceSearchPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/libs",
    ],
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/libs"
    ],
    "python-envs.pythonProjects": [
        {
            "path": "libs/gxipy",
            "envManager": "ms-python.python:conda",
            "packageManager": "ms-python.python:conda"
        }
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "src/ao_shaping/drivers/__pycache__": true,
        "**/__pycache__": true,
        "__pycache__": true,
        ".kilocode": true,
        ".marscode": true,
        ".pytest_cache": true,
        ".trae": true,
        "uv.lock": true,
        "**__pycache__": true,
        ".ocx": true,
        ".history": true,
        ".opencode": true,
        ".ruff_cache": true,
        ".venv": true,
        ".coverage": true,
        ".kilocodemodes": true
    },
    "hide-files.files": [
        "**/__pycache__",
        "__pycache__",
        ".kilocode",
        ".marscode",
        ".pytest_cache",
        ".trae",
        "uv.lock",
        "**__pycache__",
        ".ocx",
        ".history",
        ".opencode",
        ".ruff_cache",
        ".venv",
        ".coverage",
        ".kilocodemodes"
    ],
    "python.defaultInterpreterPath": "d:\\Projects\\TIFO\\AO-shaping\\.venv\\Scripts\\python.exe",
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda"
}