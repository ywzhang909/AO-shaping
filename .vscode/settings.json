{
    "terminal.integrated.env.windows": {
        "env": "${workspaceFolder}/.env",
        "python.terminal.useEnvFile": "${workspaceFolder}/.env",
        // "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/libs;${env:PYTHONPATH}",
        "PATH": "${workspaceFolder}/libs/Drv_UDPST/x64/Release;${env:PATH}",
    },
    "python.testing.pytestArgs": [
        "-s"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.terminal.useEnvFile": true,
    "python.envFile": "${workspaceFolder}/.env",
    "python.testing.pytestPath": "${workspaceFolder}/.venv/Scrits/pytest.exe",
    "[dotenv]": {
        "editor.formatOnSave": true
    },
    "python-env.workspaceSearchPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/libs",
    ],
    "python.autoComplete.extraPaths": [
        "./src"
    ],
    "python-envs.pythonProjects": [
        {
            "path": "libs/gxipy",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ]
}