# AO-Shaping 路径配置示例。复制为 ao_shaping.toml 后按需修改。
#
# 解析优先级: 环境变量 → 本文件 → 默认值。
#   数据目录: AO_SHAPING_DATA_DIR        (默认 data)
#   权重目录: SLM_MODELS_DIR / AO_SHAPING_WEIGHTS_DIR  (默认 <数据目录>/slm_models)
# 本文件位置: 源码检出为仓库根; 打包 exe 为 exe 同目录; 或用 AO_SHAPING_CONFIG 指定。
# 相对路径相对于本文件所在目录解析。

[paths]
# data_dir = "data"
# weights_dir = "D:/ao_shaping_weights"
