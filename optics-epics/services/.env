# =============================================================================
# services/.env - WSL 服务端环境变量(docker compose 使用)
# =============================================================================
# 用法:
#   cd services
#   source ../environment.sh
#   docker compose up -d
# =============================================================================

# ---- 网络(WSL 内通过 environment.sh 获得,此处为 compose 缺省值)----
WSL_IP=172.26.56.202
HOST_IP=192.168.1.100

# ---- CA 端口(与各 IOC 的 config/ioc.yaml 保持一致)----
SLM_CA_PORT=5065
DM_CA_PORT=5066
DHCAM_CA_PORT=5067
MII_CA_PORT=5068
WFS_CA_PORT=5069

# ---- CA Gateway ----
# 网关服务端端口(监听 WSL_IP:5062)
GATEWAY_PORT=5062
# 网关客户端端口(连接 IOC,使用 HOST_IP 端口段;默认与 EPICS 标准一致即可)
GATEWAY_CPORT=5061

# ---- Phoebus ----
PHOEBUS_PORT=8080

# ---- Archiver Appliance ----
ARCHIVER_PORT=17665
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=archiver

# ---- data-api ----
DATA_API_PORT=8000

# ---- CA 客户端(容器内 caget 等)----
EPICS_CA_ADDR_LIST=${WSL_IP}
EPICS_CA_AUTO_ADDR_LIST=NO
EPICS_CA_MAX_ARRAY_BYTES=10000000
