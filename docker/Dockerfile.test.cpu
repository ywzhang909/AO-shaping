# CPU-only test image for AO-Shaping, for CI runners (no GPU).
#
# Same resource policy as docker/Dockerfile.test, minus the CUDA parts:
# the CPU index ships CPU wheels for torch/torchvision, and cupy is dropped
# because it is a CUDA-only package that only runs on a CUDA host.
#
# Why a separate image rather than a build arg on the GPU one: the GPU
# Dockerfile pulls multi-GB CUDA wheels, and a CI runner has neither a GPU
# nor the disk appetite for them. The CPU index carries numpy / pillow /
# sympy / networkx / jinja2 / filelock / fsspec / mpmath / typing-extensions
# too, so `--index-url` alone resolves the whole set.
#
# The thread caps are the important part and are identical to the GPU image:
# they are what keeps a numeric library from sizing its pool at the host's
# core count. CI runners have 4 cores, but the caps are kept anyway so the
# two images behave the same way.
#
# OOPAO is vendored under libs/ and consumed as an editable install, exactly
# as in the GPU image. It needs numpy and scipy at build time, so those are
# installed from PyPI first.
FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        libsdl2-dev \
        libx11-dev \
        ffmpeg \
        git \
    && rm -rf /var/lib/apt/lists/*

ENV OMP_NUM_THREADS=16 \
    OPENBLAS_NUM_THREADS=16 \
    MKL_NUM_THREADS=16 \
    NUMEXPR_NUM_THREADS=16 \
    VECLIB_MAXIMUM_THREADS=16 \
    NUMBA_NUM_THREADS=16 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg

COPY libs/OOPAO/ /opt/OOPAO/

# torch/torchvision FIRST, from the CPU index, before anything that depends on
# torch.
#
# Order matters: torchmetrics depends on torch, so installing it first would
# pull the CUDA-linked wheel from PyPI (2.14.1, ~550 MB plus the nvidia-*
# wheels, ~3 GB) and the exact CPU pin below would then be a downgrade rather
# than the install. Installing torch first means every later torch-dependent
# package just reuses the CPU build already in the image.
#
# --extra-index-url, not --index-url: the latter REPLACES PyPI, and the CPU
# index carries only torch's own dependency closure (numpy, pillow, sympy,
# ...), so packages like torchmetrics / wandb / pytest would not be found there
# at all. The local version is pinned to the exact CPU build because the index
# also serves the plain (CUDA-linked) wheel under the same version number.
RUN pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/cpu \
      "torch==2.6.0+cpu" "torchvision==0.21.0+cpu" \
    && pip install --no-cache-dir \
      "numpy>=2.2.6" "pandas>=2.3.2" "tqdm>=4.67.1" "matplotlib>=3.9.2" \
      "pyserial>=3.5" "nidaqmx>=0.8.10" "scikit-optimize>=0.10.2" \
      "ordered-set>=4.1.0" "findlibs>=0.1.2" "loguru>=0.7.3" \
      "ansi2html>=1.9.2" "typing-extensions>=4.12.2" "coredumpy>=0.4.3" \
      "asyncer>=0.0.10" "click>=8.3.0" "setuptools>=80.9.0" "cython>=3.2.2" \
      "zernike>=0.0.33" "scipy>=1.15.0" "pillow>=11.0.0" "aotools>=1.0.7" \
      "numba>=0.65.1" "h5py>=3.14.0" "retrying>=1.3.4" "openpyxl>=3.1.5" \
      "plotly>=6.7.0" "pygame>=2.6.1" "pyarrow>=25.0.1" "jsonpickle>=4.1.2" \
      "scikit-image>=0.26.0" "astropy>=8.0.1" "streamlit>=1.40.0" \
      "streamlit-aggrid>=1.2.1.post2" "streamlit-drawable-canvas>=0.9.3" \
      "ipywidgets>=8.1.8" \
      "torchmetrics>=1.4.0" "wandb>=0.20.0" \
      "pytest>=9.0.3" "pytest-asyncio>=0.23.0" "pytest-timeout>=2.3.1" \
    && pip install --no-cache-dir --no-deps -e /opt/OOPAO

WORKDIR /workspace
CMD ["python", "-c", "print('ao-shaping CPU test image ready')"]
