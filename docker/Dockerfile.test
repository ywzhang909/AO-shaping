# GPU test image for AO-Shaping.
#
# Resource policy this image encodes
# ---------------------------------
# CPU: the host has 384 cores. Run it with `--cpus=16 --pids-limit=2048`
#      (see run_pytest.sh). `--cpus` is a CFS quota, so it does NOT lower
#      `nproc`, and `os.cpu_count()` still reports 384 inside the container.
#      The env vars below are therefore the only thing that shrinks the pools.
#      A GPU does not help here: the dominant consumer (OOPAO handing
#      `multiprocessing.cpu_count()` to pyfftw/joblib) is pure CPU work.
# GPU: docker's `--gpus` has no VRAM ceiling. The 4 GB limit is applied
#      in-process by conftest.py through `torch.cuda.set_per_process_memory_fraction`
#      plus the CuPy malloc-heap limit, because the caching allocators are what
#      the repo's tensors and device arrays actually pass through.
#
# torch stays in the same install command as everything else on purpose:
# isolated into its own layer, a version bump re-resolves and re-downloads
# ~3 GB of CUDA wheels instead of reusing the shared resolution.
FROM python:3.13-slim

# build-essential: a few scientific wheels still build from source.
# libgl1 + libglib2.0-0: scikit-image / imaging.
# libsdl2-dev + libx11-dev: pygame, used by the live-display code paths.
# ffmpeg: the video backend decode tests.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        libsdl2-dev \
        libx11-dev \
        ffmpeg \
        git \
    && rm -rf /var/lib/apt/lists/*

# Must be set BEFORE any wheel is imported. OpenBLAS, MKL, OpenMP and numba all
# read these once at load time; exporting them later leaves every pool sized at
# the host core count (384 here), which is what OOPAO's pyfftw/joblib fan-out
# turned into ~390 OS threads.
#
# The value must equal `CORE_BUDGET` in tests/conftest.py. Both conftests pin
# with `os.environ.setdefault`, so this ENV is a hard override: leaving it below
# the budget silently defeats the pinning and
# test_conventions.py::test_the_thread_budget_is_in_force_in_this_process fails
# with e.g. OPENBLAS_NUM_THREADS='4', expected 16. It matches the container's
# --cpus=16 quota, so a bare `docker run` of this image is bounded too.
ENV OMP_NUM_THREADS=16 \
    OPENBLAS_NUM_THREADS=16 \
    MKL_NUM_THREADS=16 \
    NUMEXPR_NUM_THREADS=16 \
    VECLIB_MAXIMUM_THREADS=16 \
    NUMBA_NUM_THREADS=16 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg

# OOPAO is vendored under libs/ and consumed as an editable install.
COPY libs/OOPAO/ /opt/OOPAO/

RUN pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/cu130 \
      "numpy>=2.2.6" "pandas>=2.3.2" "tqdm>=4.67.1" "matplotlib>=3.9.2" \
      "pyserial>=3.5" "nidaqmx>=0.8.10" "scikit-optimize>=0.10.2" \
      "ordered-set>=4.1.0" "findlibs>=0.1.2" "loguru>=0.7.3" \
      "ansi2html>=1.9.2" "typing-extensions>=4.12.2" "coredumpy>=0.4.3" \
      "asyncer>=0.0.10" "click>=8.3.0" "setuptools>=80.9.0" "cython>=3.2.2" \
      "zernike>=0.0.33" "scipy>=1.15.0" "pillow>=11.0.0" "aotools>=1.0.7" \
      "numba>=0.65.1" "h5py>=3.14.0" "retrying>=1.3.4" "openpyxl>=3.1.5" \
      "plotly>=6.7.0" "pygame>=2.6.1" "pyarrow>=25.0.1" "jsonpickle>=4.1.2" \
      "scikit-image>=0.26.0" "astropy>=8.0.1" "streamlit>=1.40.0" \
      "streamlit-aggrid>=1.2.1.post2" "streamlit-drawable-canvas>=0.9.3" \
      "ipywidgets>=8.1.8" "cupy-cuda13x>=14.2.0" \
      "torch>=2.4.0" "torchvision>=0.20" "torchmetrics>=1.4.0" "wandb>=0.20.0" \
      "pytest>=9.0.3" "pytest-asyncio>=0.23.0" "pytest-timeout>=2.3.0" \
    && pip install --no-cache-dir --no-deps -e /opt/OOPAO

WORKDIR /workspace
CMD ["python", "-c", "print('ao-shaping GPU test image ready')"]