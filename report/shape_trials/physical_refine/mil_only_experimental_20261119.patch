+def parse_residual_modes(text):
+    """Parse ``"5-21"`` or ``"5,6,7"`` into ascending unique Noll indices."""
+    modes = []
+    for part in str(text).split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            start, end = (int(v) for v in part.split("-", 1))
+            if end < start:
+                raise ValueError(f"descending mode range: {part!r}")
+            modes.extend(range(start, end + 1))
+        else:
+            modes.append(int(part))
+    if not modes:
+        raise ValueError("residual mode list is empty")
+    return sorted(set(modes))
+
