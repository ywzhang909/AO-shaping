+# CCD-blur sigma the kernel builder may use. The optimiser's parameter is
+# ``sigma_ccd_px`` itself and is deliberately not clamped: the builder clamps, so
+# a step outside the range is accepted and simply re-projects the same kernel.
+SIGMA_CCD_PX_RANGE = (0.0, 5.0)
+
+# High-pass sigma of the shared static-structure construction, in camera-grid
+# pixels. The fit samples every 2nd CCD pixel, so 3.0 here is the 6.0 px used by
+# ``scripts/slm/characterize_transfer_static_structure.py``.
+STATIC_HIGHPASS_SIGMA_PX = 3.0
+
+
+def static_basis(images, train, k, *, sigma=STATIC_HIGHPASS_SIGMA_PX):
+    """K orthonormal high-pass maps built from TRAIN rows only.
+
+    Same construction as ``scripts/slm/characterize_transfer_static_structure.py``:
+    per-image mean normalisation, Gaussian high-pass, per-row mean subtraction,
+    SVD — the leading right singular vectors are the maps. ``validation`` and
+    ``test`` rows never enter the basis.
+    """
+    if k <= 0:
+        return None
+    from scipy.ndimage import gaussian_filter
+
+    stack = np.asarray(images[train], dtype=np.float64)
+    if stack.ndim != 3 or stack.shape[0] == 0:
+        raise ValueError("static basis needs a nonempty train stack")
+    stack = stack / np.maximum(stack.mean(axis=(1, 2), keepdims=True), 1e-12)
+    highpass = stack - gaussian_filter(stack, (0, sigma, sigma))
+    flat = highpass.reshape(len(highpass), -1)
+    flat = flat - flat.mean(axis=1, keepdims=True)
+    k = min(int(k), *flat.shape)
+    _, _, vt = np.linalg.svd(flat, full_matrices=False)
+    return np.ascontiguousarray(vt[:k].reshape(k, *highpass.shape[1:]), dtype=np.float32)
+
+
+class LearnableCcdBlur:
+    """Differentiable replacement for the frozen 25x25 Gaussian CCD blur.
+
+    ``sigma_ccd_px`` is the only parameter and it is *linear*, not logarithmic:
+    the checkpoint this fit warm-starts from has ``sigma_ccd_px = 0`` (no CCD
+    blur at all), and a log parameter cannot represent 0. At 0 :meth:`kernel`
+    returns ``None`` — the same thing ``FrozenDefocusForward._build_blaze_kernel``
+    returns for a non-positive sigma — so the checkpoint reproduces the frozen
+    forward pass bit-for-bit. Note the zero is a boundary: the delta kernel has no
+    gradient in sigma, so a fit that starts there stays there unless a positive
+    width is supplied.
+    """
+
+    def __init__(self, sigma_ccd_px, device):
+        import torch
+
+        low, high = SIGMA_CCD_PX_RANGE
+        sigma = float(sigma_ccd_px)
+        if not np.isfinite(sigma):
+            sigma = low
+        sigma = min(max(sigma, low), high)
+        self.sigma = torch.nn.Parameter(
+            torch.tensor(sigma, dtype=torch.float32, device=device))
+
+    def kernel(self):
+        import torch
+
+        low, high = SIGMA_CCD_PX_RANGE
+        sigma = self.sigma.clamp(low, high)
+        if float(sigma.detach()) <= 0.0:
+            # Exactly the frozen builder's non-positive branch: no convolution.
+            return None
+        grid = torch.arange(-12, 13, dtype=torch.float32, device=sigma.device)
+        kernel = torch.exp(-0.5 * (grid / (sigma / 2.0)) ** 2)
+        kernel = kernel / kernel.sum()
+        return (kernel[:, None] * kernel[None, :])[None, None]
+
+    def sigma_px(self) -> float:
+        low, high = SIGMA_CCD_PX_RANGE
+        return float(self.sigma.detach().clamp(low, high))
 
 
