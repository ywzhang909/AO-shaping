# src            — ao_shaping 包
# libs           — gxipy / santec_slm 等 SDK 绑定
# libs/OOPAO     — OOPAO 包本身在 libs/OOPAO/OOPAO, 只加 libs 不够。
#                  共享 .venv 时它的 __editable__.oopao .pth 会把 OOPAO 指到
#                  主仓库, 所以必须显式把本 worktree 的 libs/OOPAO 放在前面。
PYTHONPATH=src;libs;libs/OOPAO
# PATH=libs\Drv_UDPST\x64\Release;libs\gxipy;${PATH}
Far_Cam_ID=0
Near_Cam_ID=1
IDEAL_SPOT_RADIUS=7
CENTER=577,655
# Santec SLM 的 SLMFunc.dll 目录。
#
# 默认留空 —— 不要取消注释。_slm_win.py 会用 ROOT_DIR (自
# src/ao_shaping/utils/io/file.py 上溯 5 级 = 仓库根) 自动拼出
# <repo_root>/libs/santec_slm, 已经跟着当前 checkout / worktree 走。
#
# 只有当 DLL 不在仓库的 libs/santec_slm 下时才需要设, 且必须是**绝对路径**:
# 该值直接传给 os.add_dll_directory(), 传相对路径会 WinError 87。
# 另外它排在候选列表第一位, 一旦设错就会压过上面的自动发现。
# AO_SHAPING_SLM_DLL_DIR=D:\Projects\TIFO\AO-shaping\libs\santec_slm

# Daheng 相机保护曝光上限 (ms)。随光路/衰减变化, 按会话设置;
# 不设置或为 0 时由代码按画面自动探测 (倍增曝光阶梯直到饱和)。
# AO_DAHENG_MAX_EXPOSURE_MS=0.6

# ============================================
# PyTorch 版本选择（根据 GPU 手动设置）
# ============================================
# GTX 10xx / RTX 20xx / 旧显卡 → 设置为 cu124
# RTX 30xx / 40xx → 设置为 cu124
# RTX 50xx (Blackwell) → 设置为 cu130
# TORCH_INDEX=https://download.pytorch.org/whl/cu124
# TORCH_INDEX=https://download.pytorch.org/whl/cu130