# ============================================
# AO-Shaping Environment Configuration
# ============================================
# Copy this file to .env.local and customize for your setup

# ============================================
# Python Path Configuration
# ============================================
# Add src and libs to Python path for imports.
# libs/OOPAO is required too: the OOPAO package lives at libs/OOPAO/OOPAO, so
# "libs" alone does not expose it. Without this entry a shared .venv resolves
# OOPAO through its __editable__ .pth into whichever checkout created it.
PYTHONPATH=src;libs;libs/OOPAO

# ============================================
# System Path Configuration (for DLLs/shared libraries)
# ============================================
# Windows path separator is ;
PATH=libs\Drv_UDPST\x64\Release;libs\gxipy;${PATH}

# ============================================
# Hardware Device IDs
# ============================================
# Camera IDs for far-field and near-field cameras
Far_Cam_ID=0
Near_Cam_ID=1

# ============================================
# Optical Parameters
# ============================================
# Ideal spot radius for PIB optimization (in pixels)
IDEAL_SPOT_RADIUS=7

# ============================================
# SLM Configuration
# ============================================
# Path to Santec SLM DLL files (Windows only)
#
# Leave unset. _slm_win.py already resolves <repo_root>/libs/santec_slm from
# ROOT_DIR, so the DLL follows whatever checkout/worktree you run from. Set
# this only if the DLL lives outside the repo's libs/santec_slm, and then it
# MUST be absolute — os.add_dll_directory() raises WinError 87 on a relative
# path. It also takes precedence over the automatic ROOT_DIR lookup, so a
# stale value here silently wins over the worktree copy.
# AO_SHAPING_SLM_DLL_DIR=/absolute/path/to/santec_slm

# ============================================
# PyTorch CUDA Version Selection
# ============================================
# Uncomment the appropriate line for your GPU:
# 
# For GTX 10xx / RTX 20xx / Older cards → cu124
# TORCH_INDEX=https://download.pytorch.org/whl/cu124
#
# For RTX 30xx / 40xx → cu124  
# TORCH_INDEX=https://download.pytorch.org/whl/cu124
#
# For RTX 50xx (Blackwell) → cu130
# TORCH_INDEX=https://download.pytorch.org/whl/cu130

# ============================================
# Development Settings
# ============================================
# Enable debug mode (True/False)
# AO_SHAPING_DEBUG=False

# Log level (DEBUG, INFO, WARNING, ERROR)
# AO_SHAPING_LOG_LEVEL=INFO

# ============================================
# Data Paths
# ============================================
# Root directory for experimental data
# AO_SHAPING_DATA_DIR=data

# Directory for saved voltages
# AO_SHAPING_VOLTAGES_DIR=data/flatten_voltages

# Directory for debug logs
# AO_SHAPING_LOG_DIR=logs/debug/error